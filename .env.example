# Copy to .env.local and fill in. Never commit .env.local.

# --- Public (inlined into the browser bundle) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Server only ---
# Supabase secret key (bypasses RLS — server use only)
SUPABASE_SECRET_KEY=sb_secret_xxx
# Only used by `npm run db:push` / `db:types` (Supabase → Connect → Session pooler URI)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Stripe → Developers → API keys (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe CLI `stripe listen` locally, or the dashboard webhook endpoint in production
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend → API Keys
RESEND_API_KEY=re_xxx
# Use onboarding@resend.dev until a domain is verified in Resend
EMAIL_FROM="Digital Heroes <onboarding@resend.dev>"

# Random string (min 16 chars) that Vercel Cron sends as a Bearer token
CRON_SECRET=change-me-to-a-long-random-string

# Switches on the live Xero API provider (CSV export is always available)
FEATURE_XERO_API=false
