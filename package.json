{
  "name": "makeready",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:push": "node scripts/db.mjs push",
    "db:types": "node scripts/db.mjs types",
    "db:seed-users": "node --env-file=.env.local scripts/seed-users.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "fflate": "^0.8.3",
    "next": "16.4.6",
    "opentype.js": "^2.0.0",
    "papaparse": "^5.7.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.40.1",
    "server-only": "^0.0.1",
    "stripe": "^23.2.0",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.7",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
